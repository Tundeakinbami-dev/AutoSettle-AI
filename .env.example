# .env.example
# ------------------------------------------------------------
# Copy this file to .env and replace the placeholder values.
# Never commit real credentials to source control.

# Database connection (SQLite example)
DATABASE_URL="file:./dev.db"

# PayPal configuration
# Create a PayPal developer app (sandbox) and enable Customer Disputes API.
# Obtain the sandbox client ID and secret from the PayPal Developer Dashboard.
PAYPAL_CLIENT_ID="YOUR_PAYPAL_SANDBOX_CLIENT_ID"
PAYPAL_CLIENT_SECRET="YOUR_PAYPAL_SANDBOX_CLIENT_SECRET"
# Set to 'sandbox' for development or 'live' for production.
PAYPAL_ENVIRONMENT="sandbox"
# Webhook ID registered in PayPal Developer Dashboard
PAYPAL_WEBHOOK_ID="YOUR_PAYPAL_WEBHOOK_ID"
PAYPAL_WEBHOOK_SECRET="YOUR_PAYPAL_WEBHOOK_SECRET"

# AI Provider configuration
AI_API_KEY="YOUR_AI_PROVIDER_API_KEY"
AI_MODEL="gpt-4o"

# Application base URL (used for webhook callbacks, etc.)
BASE_URL="http://localhost:3000"

# Application mode: DEMO (synthetic data) or SANDBOX (live PayPal sandbox)
APP_MODE="DEMO"

# Courier / Carrier Tracking Integration
# CARRIER_INTEGRATION_MODE: "SIMULATED" (default) | "EASYPOST" | "UPS"
CARRIER_INTEGRATION_MODE="SIMULATED"
# EasyPost Credentials (if CARRIER_INTEGRATION_MODE="EASYPOST")
EASYPOST_API_KEY="EZAK_test_..."
# Direct UPS REST API Credentials (if CARRIER_INTEGRATION_MODE="UPS")
UPS_CLIENT_ID="your_ups_client_id"
UPS_CLIENT_SECRET="your_ups_client_secret"
UPS_ENVIRONMENT="sandbox" # "sandbox" or "production"

# Evidence Storage Configuration
# Files are stored outside the public directory for security
EVIDENCE_STORAGE_PATH="./storage/evidence"
MAX_FILE_SIZE_MB=10
