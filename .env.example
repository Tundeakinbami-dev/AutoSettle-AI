# .env.example
# ------------------------------------------------------------
# Copy this file to .env and replace the placeholder values.
# Never commit real credentials to source control.

# Database connection (SQLite example)
DATABASE_URL="file:./dev.db"

# PayPal configuration
# Create a PayPal developer app (sandbox) and enable Customer Disputes API.
# Obtain the sandbox client ID and secret from the PayPal Developer Dashboard.
PAYPAL_CLIENT_ID="YOUR_PAYPAL_SANDBOX_CLIENT_ID"
PAYPAL_CLIENT_SECRET="YOUR_PAYPAL_SANDBOX_CLIENT_SECRET"
# Set to 'sandbox' for development or 'live' for production.
PAYPAL_ENVIRONMENT="sandbox"
# After setting up a webhook in PayPal, copy the webhook ID here.
PAYPAL_WEBHOOK_ID="YOUR_PAYPAL_WEBHOOK_ID"

# AI Provider configuration
# Example: OpenAI API key and model selection.
AI_API_KEY="YOUR_AI_PROVIDER_API_KEY"
AI_MODEL="gpt-4o"

# Application base URL (used for webhook callbacks, etc.)
BASE_URL="http://localhost:3000"

# Application mode: DEMO (synthetic data) or SANDBOX (live PayPal sandbox)
APP_MODE="DEMO"

# ------------------------------------------------------------
# Setup Instructions
# ------------------------------------------------------------
# 1. Create a PayPal Developer Account: https://developer.paypal.com/
# 2. In the Dashboard, create a new "REST API app".
#    - Enable the "Customer Disputes" product.
#    - Under "Sandbox App Settings", note the Client ID and Secret.
# 3. Configure a Webhook:
#    - URL: <BASE_URL>/api/webhook/paypal (replace <BASE_URL> with your actual base URL).
#    - Events: SELECT the dispute-related events you need, e.g.,
#      * PAYMENT.DISPUTE.CREATED
#      * PAYMENT.DISPUTE.UPDATED
#      * PAYMENT.DISPUTE.RESOLVED
#    - Save the webhook and copy the generated Webhook ID.
# 4. Fill in the .env file with the values above.
# 5. Run the seed script to populate demo data:
#    npm run seed
# 6. Start the development server:
#    npm run dev
#
# For production, set APP_MODE="SANDBOX" and provide live PayPal credentials.
